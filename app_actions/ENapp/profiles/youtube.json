{
    "app": "youtube",
    "package": "com.google.android.youtube",
    "keyword": "apple",
    "selectors": {
        "search_button": [
            {
                "resourceId": "com.google.android.youtube:id/menu_item_view",
                "description": "搜索"
            },
            {
                "description": "Search"
            }
        ],
        "search_input": [
            {
                "resourceId": "com.google.android.youtube:id/search_edit_text"
            },
            {
                "className": "android.widget.EditText"
            }
        ],
        "first_video": [
            {
                "className": "android.view.ViewGroup",
                "descriptionMatches": "(?is).* - (播放视频|Play video)$",
                "clickable": true,
                "enabled": true
            }
        ],
        "player": [
            {
                "resourceId": "com.google.android.youtube:id/watch_player"
            }
        ],
        "miniplayer": [
            {
                "resourceId": "com.google.android.youtube:id/floaty_bar_controls_view"
            }
        ],
        "close_miniplayer": [
            {
                "resourceId": "com.google.android.youtube:id/modern_miniplayer_close"
            }
        ]
    }
}