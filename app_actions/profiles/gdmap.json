{
    "app": "gdmap",
    "package": "com.autonavi.minimap",
    "validation": "UNVERIFIED_ON_DEVICE",
    "fast_mode": true,
    "evidence": "final",
    "poll_interval": 0.15,
    "cache_window_size": true,
    "native_window_size": true,
    "success_evidence": "screenshot",
    "home_native": true,
    "return_reserve_seconds": 4.0,
    "home": [
        [
            {
                "resourceId": "com.autonavi.minimap:id/txt_hotword"
            }
        ]
    ],
    "steps": [
        {
            "name": "open_search",
            "action": "click",
            "native_expect_groups": true,
            "expect_timeout": 2,
            "selectors": [
                {
                    "description": "搜索"
                },
                {
                    "descriptionContains": "搜索"
                },
                {
                    "text": "搜索"
                },
                {
                    "textContains": "搜索"
                }
            ],
            "expect": [
                [
                    {
                        "className": "android.widget.EditText"
                    }
                ]
            ]
        },
        {
            "name": "input_keyword",
            "action": "input",
            "native_input": true,
            "input_timeout": 2,
            "selectors": [
                {
                    "className": "android.widget.EditText",
                    "enabled": true,
                    "focused": true
                }
            ],
            "value": "华中科技大学"
        },
        {
            "name": "submit_search",
            "action": "click",
            "selectors": [
                {
                    "text": "搜索"
                },
                {
                    "description": "搜索"
                }
            ],
            "expect": [
                [
                    {
                        "text": "华中科技大学",
                        "minYRatio": 0.2
                    },
                    {
                        "textContains": "华中科技大学",
                        "minYRatio": 0.2,
                        "className": "android.widget.TextView"
                    },
                    {
                        "descriptionContains": "华中科技大学",
                        "minYRatio": 0.2
                    }
                ]
            ]
        },
        {
            "name": "return_to_home",
            "action": "back_until_home_native",
            "home_resource_id": "com.autonavi.minimap:id/txt_hotword",
            "max_back": 5,
            "return_timeout": 4,
            "back_delay": 0.15,
            "native_expect_groups": true,
            "expect_timeout": 1,
            "trace_timing": true,
            "expect": [
                [
                    {
                        "resourceId": "com.autonavi.minimap:id/txt_hotword"
                    }
                ]
            ]
        }
    ]
}
