{
    "app": "dianping",
    "package": "com.dianping.v1",
    "validation": "UNVERIFIED_ON_DEVICE",
    "fast_mode": true,
    "evidence": "final",
    "poll_interval": 0.15,
    "cache_window_size": true,
    "native_window_size": true,
    "success_evidence": "screenshot",
    "home_native": true,
    "return_reserve_seconds": 3.0,
    "home": [
        [
            {
                "text": "首页"
            },
            {
                "text": "我的"
            }
        ]
    ],
    "steps": [
        {
            "name": "open_search",
            "action": "click",
            "native_expect_groups": true,
            "expect_timeout": 2,
            "selectors": [
                {
                    "className": "android.view.View",
                    "clickable": true,
                    "within": {
                        "resourceId": "com.dianping.v1:id/title_search_bar"
                    }
                }
            ],
            "expect": [
                [
                    {
                        "className": "android.widget.EditText"
                    }
                ]
            ]
        },
        {
            "name": "input_keyword",
            "action": "input",
            "selectors": [
                {
                    "className": "android.widget.EditText"
                }
            ],
            "value": "咖啡"
        },
        {
            "name": "submit_search",
            "action": "click",
            "selectors": [
                {
                    "text": "搜索"
                },
                {
                    "description": "搜索"
                }
            ],
            "expect": [
                [
                    {
                        "text": "咖啡",
                        "minYRatio": 0.2
                    },
                    {
                        "textContains": "咖啡",
                        "minYRatio": 0.2,
                        "className": "android.widget.TextView"
                    }
                ]
            ]
        },
        {
            "name": "return_to_search_page",
            "action": "back",
            "native_expect_groups": true,
            "expect_timeout": 2,
            "expect": [
                [
                    {
                        "className": "android.widget.EditText"
                    }
                ]
            ]
        },
        {
            "name": "dismiss_keyboard",
            "action": "back",
            "native_expect_groups": true,
            "expect_timeout": 2,
            "expect": [
                [
                    {
                        "className": "android.widget.EditText"
                    }
                ]
            ]
        },
        {
            "name": "return_to_home",
            "action": "back",
            "native_expect_groups": true,
            "expect_timeout": 2,
            "expect": [
                [
                    {
                        "text": "首页"
                    },
                    {
                        "text": "我的"
                    }
                ]
            ]
        }
    ]
}
