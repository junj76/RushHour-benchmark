{
    "app": "meituan",
    "package": "com.sankuai.meituan",
    "validation": "UNVERIFIED_ON_DEVICE",
    "fast_mode": true,
    "evidence": "final",
    "poll_interval": 0.15,
    "cache_window_size": true,
    "native_window_size": true,
    "success_evidence": "screenshot",
    "return_reserve_seconds": 3.0,
    "home": [
        [
            {
                "description": "\u5916\u5356",
                "clickable": true,
                "maxYRatio": 0.45
            }
        ]
    ],
    "steps": [
        {
            "name": "open_search",
            "action": "click",
            "native_click": true,
            "selectors": [
                {
                    "descriptionContains": "\u641c\u7d22\u6846",
                    "className": "android.widget.TextView"
                }
            ],
            "native_expect_groups": true,
            "expect_timeout": 2,
            "expect": [
                [
                    {
                        "className": "android.widget.EditText"
                    }
                ]
            ]
        },
        {
            "name": "input_keyword",
            "action": "input",
            "native_input": true,
            "input_timeout": 2,
            "selectors": [
                {
                    "className": "android.widget.EditText"
                }
            ],
            "value": "\u5496\u5561"
        },
        {
            "name": "submit_search",
            "action": "enter",
            "expect_timeout": 4,
            "expect": [
                [
                    {
                        "resourceId": "com.sankuai.meituan:id/default_text",
                        "text": "\u5496\u5561"
                    }
                ],
                [
                    {
                        "description": "\u5730\u56fe\u641c\u7d22 \u6309\u94ae",
                        "clickable": true
                    }
                ]
            ]
        },
        {
            "name": "return_to_home",
            "action": "back_until_home_native",
            "home_resource_id": "com.sankuai.meituan:id/search_layout_area",
            "max_back": 6,
            "return_timeout": 4,
            "back_delay": 0.1,
            "trace_timing": true,
            "expect_timeout": 2,
            "expect": [
                [
                    {
                        "description": "\u5916\u5356",
                        "clickable": true,
                        "maxYRatio": 0.45
                    }
                ]
            ]
        }
    ]
}